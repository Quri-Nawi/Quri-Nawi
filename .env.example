# Opt-in: permite enviar referencias públicas a la cola D1 del MCP existente.
# Sin esta variable, el borrador y su descarga siguen funcionando.
# No se necesita ni se acepta ADMIN_TOKEN desde el navegador.
QURI_PROPOSALS_ENABLED=0

# Voz de Quri (OpenAI Realtime). Solo en el servidor: nunca con prefijo NEXT_PUBLIC_.
API_KEY_OPENAI=
# Opcional: modelo de voz en tiempo real.
# QURI_REALTIME_MODEL=gpt-realtime-2.1-mini
